{% assign home_collection = section.settings.collection %}
{% if home_collection == blank %}
  {% assign home_collection = collections['all'] %}
{% endif %}

{% assign hero_product = section.settings.featured_product %}
{% if hero_product == blank and home_collection != blank %}
  {% assign matching_products = home_collection.products | where: 'title', 'Everyday Stoneware Mug' %}
  {% assign hero_product = matching_products.first %}
  {% if hero_product == blank %}
    {% assign hero_product = home_collection.products.first %}
  {% endif %}
{% endif %}

{% assign hero_image = section.settings.hero_image %}
{% if hero_image == blank and hero_product != blank %}
  {% assign hero_image = hero_product.featured_image %}
{% endif %}
{% if hero_image == blank and home_collection != blank %}
  {% assign hero_image = home_collection.featured_image %}
{% endif %}

<section class="northfold-home-hero full-width">
  <div class="northfold-home-hero__copy">
    <p class="northfold-home-hero__eyebrow">{{ 'sections.northfold_home.eyebrow' | t | escape }}</p>
    <h1>{{ 'sections.northfold_home.title' | t | escape }}</h1>
    <p class="northfold-home-hero__description">{{ 'sections.northfold_home.description' | t | escape }}</p>

    {% if home_collection != blank %}
      {% if home_collection.products_count > 0 %}
        <a class="northfold-home-hero__button" href="{{ home_collection.url }}">
          {{ 'sections.northfold_home.shop_collection' | t | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% elsif collections['all'].products_count > 0 %}
        <a class="northfold-home-hero__button" href="{{ routes.all_products_collection_url }}">
          {{ 'sections.northfold_home.shop_all' | t | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% else %}
        <p class="northfold-home-hero__empty">{{ 'sections.northfold_home.no_products' | t | escape }}</p>
      {% endif %}
    {% else %}
      <p class="northfold-home-hero__empty">{{ 'sections.northfold_home.no_products' | t | escape }}</p>
    {% endif %}
  </div>

  <div class="northfold-home-hero__visual">
    {% if hero_image != blank %}
      {{ hero_image | image_url: width: 2000 | image_tag: widths: '750, 1000, 1400, 1800, 2000', sizes: '(min-width: 750px) 58vw, 100vw', alt: hero_image.alt | default: hero_product.title | default: shop.name, loading: 'eager' }}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .northfold-home-hero {
    display: grid;
    min-height: calc(90vh - 8.5rem);
    min-height: calc(90svh - 8.5rem);
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: stretch;
    background: #f4f0e9;
    color: #292d22;
  }

  .northfold-home-hero__copy {
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    padding: clamp(2rem, 4vw, 4rem) clamp(1.25rem, 3.2vw, 3.25rem) clamp(2rem, 4vw, 4rem) max(var(--page-margin), calc((100vw - var(--page-width)) / 2));
  }

  .northfold-home-hero__eyebrow {
    margin-block-end: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .northfold-home-hero h1 {
    max-width: 12ch;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3rem, 4.2vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .northfold-home-hero__description {
    max-width: 34rem;
    margin-block-start: 1.5rem;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    line-height: 1.65;
  }

  .northfold-home-hero__button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    gap: 0.75rem;
    margin-block-start: 2rem;
    padding: 0.8rem 1.5rem;
    background: #3b402a;
    color: #fff;
    text-decoration: none;
  }

  .northfold-home-hero__button:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
  }

  .northfold-home-hero__visual {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: #f4f0e9;
  }

  .northfold-home-hero__visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .northfold-home-hero__empty {
    margin-block-start: 1.5rem;
    line-height: 1.6;
  }

  @media (min-width: 750px) and (max-width: 899px) {
    .northfold-home-hero {
      min-height: calc(90vh - 7.25rem);
      min-height: calc(90svh - 7.25rem);
    }
  }

  @media (max-width: 749px) {
    .northfold-home-hero {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr);
    }

    .northfold-home-hero__copy {
      padding: 3.5rem 1.5rem 2.5rem;
    }

    .northfold-home-hero h1 {
      max-width: 12ch;
      font-size: clamp(2.8rem, 10vw, 4rem);
    }

    .northfold-home-hero__visual {
      min-height: 0;
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.northfold_home.name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.northfold_home.settings.collection.label"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "t:sections.northfold_home.settings.featured_product.label"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "t:sections.northfold_home.settings.hero_image.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.northfold_home.name"
    }
  ]
}
{% endschema %}
