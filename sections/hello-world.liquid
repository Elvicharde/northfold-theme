{% assign home_collection = section.settings.collection %}

<section class="northfold-home full-width">
  <div class="northfold-home__content">
    <p class="northfold-home__eyebrow">{{ 'sections.northfold_home.eyebrow' | t | escape }}</p>
    <h1>{{ 'sections.northfold_home.title' | t | escape }}</h1>
    <p class="northfold-home__description">{{ 'sections.northfold_home.description' | t | escape }}</p>

    {% if home_collection != blank %}
      {% if home_collection.products_count > 0 %}
        <a class="northfold-home__button" href="{{ home_collection.url }}">
          {{ 'sections.northfold_home.shop_collection' | t | escape }}
        </a>
      {% elsif collections['all'].products_count > 0 %}
        <a class="northfold-home__button" href="{{ routes.all_products_collection_url }}">
          {{ 'sections.northfold_home.shop_all' | t | escape }}
        </a>
      {% else %}
        <p class="northfold-home__empty">{{ 'sections.northfold_home.no_products' | t | escape }}</p>
      {% endif %}
    {% elsif collections['all'].products_count > 0 %}
      <a class="northfold-home__button" href="{{ routes.all_products_collection_url }}">
        {{ 'sections.northfold_home.shop_all' | t | escape }}
      </a>
    {% else %}
      <p class="northfold-home__empty">{{ 'sections.northfold_home.no_products' | t | escape }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .northfold-home {
    display: grid;
    grid-template-columns: var(--content-grid);
    padding-block: clamp(5rem, 13vw, 11rem);
    background: #f4f0e9;
    color: #292721;
  }

  .northfold-home__content {
    grid-column: 2;
    width: min(100%, 48rem);
    padding-inline: 1.5rem;
  }

  .northfold-home__eyebrow {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .northfold-home h1 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-primary--family, inherit);
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 400;
    line-height: 0.98;
  }

  .northfold-home__description {
    max-width: 42rem;
    margin: 1.5rem 0 2rem;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.65;
  }

  .northfold-home__button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    background: #292721;
    color: #fff;
    text-decoration: none;
  }

  .northfold-home__button:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 4px;
  }

  .northfold-home__empty {
    margin: 0;
    line-height: 1.6;
  }

  @media (max-width: 749px) {
    .northfold-home {
      padding-block: 5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.northfold_home.name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.northfold_home.settings.collection.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.northfold_home.name"
    }
  ]
}
{% endschema %}
