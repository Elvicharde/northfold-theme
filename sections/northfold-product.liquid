{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'NorthfoldProductForm-' | append: section.id %}
{% assign gallery_hero_image = product.featured_image | default: product.images.first %}
{% assign shipping_threshold_amount = settings.free_shipping_threshold | default: 0 | plus: 0 %}
{% assign shipping_subunits_per_unit = 100 %}
{% case shop.currency %}
  {% when 'BIF', 'CLP', 'DJF', 'GNF', 'ISK', 'JPY', 'KMF', 'KRW', 'PYG', 'RWF', 'UGX', 'UYI', 'VND', 'VUV', 'XAF', 'XOF', 'XPF' %}
    {% assign shipping_subunits_per_unit = 1 %}
  {% when 'BHD', 'IQD', 'JOD', 'KWD', 'LYD', 'OMR', 'TND' %}
    {% assign shipping_subunits_per_unit = 1000 %}
  {% when 'CLF', 'UYW' %}
    {% assign shipping_subunits_per_unit = 10000 %}
{% endcase %}
{% assign shipping_threshold = shipping_threshold_amount | times: shipping_subunits_per_unit %}
{% assign shipping_threshold_floor = shipping_threshold | floor %}
{% assign shipping_cart_total = cart.total_price | default: 0 | plus: 0 %}
{% if shipping_threshold > 0 and shipping_threshold == shipping_threshold_floor %}
  {% assign shipping_remaining = shipping_threshold | minus: shipping_cart_total | at_least: 0 %}
  {% assign shipping_remaining_formatted = shipping_remaining | money %}
  {% assign shipping_progress = shipping_cart_total | times: 100.0 | divided_by: shipping_threshold | at_most: 100 | at_least: 0 %}
{% endif %}

<section
  class="northfold-product full-width"
  data-northfold-product
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-error-message="{{ 'products.product.options_error' | t | escape }}"
  style="--northfold-background: {{ section.settings.background_color }};"
  aria-labelledby="NorthfoldProductTitle-{{ section.id }}"
>
  <div class="northfold-product__layout">
    <div class="northfold-product__gallery" data-northfold-gallery role="group" aria-label="{{ 'products.product.gallery' | t | escape }}">
      {% if gallery_hero_image %}
        <div class="northfold-product__hero">
          {{ gallery_hero_image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 50vw, 100vw', alt: gallery_hero_image.alt | default: product.title, loading: 'eager' }}
        </div>
        {% if product.images.size > 1 %}
          {% if product.images.size > 3 %}
            <div class="northfold-product__thumbnail-navigation" data-northfold-thumbnail-navigation>
              <button
                class="northfold-product__thumbnail-arrow"
                type="button"
                aria-label="{{ 'products.product.previous_images' | t | escape }}"
                aria-controls="NorthfoldThumbnails-{{ section.id }}"
                data-northfold-thumbnail-previous
                disabled
              ><span aria-hidden="true">&larr;</span></button>
          {% endif %}
          <div
            class="northfold-product__thumbnails"
            id="NorthfoldThumbnails-{{ section.id }}"
            role="group"
            aria-label="{{ 'products.product.gallery' | t | escape }}"
            data-northfold-thumbnails
          >
            {% for image in product.images %}
              <button
                class="northfold-product__thumbnail"
                type="button"
                aria-label="{{ 'products.product.view_image' | t: index: forloop.index, alt: image.alt | default: product.title | escape }}"
                aria-pressed="{% if image.id == gallery_hero_image.id %}true{% else %}false{% endif %}"
                data-northfold-thumbnail
                data-image-id="{{ image.id }}"
                data-image-src="{{ image | image_url: width: 1200 }}"
                data-image-srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
                data-image-alt="{{ image.alt | default: product.title | escape }}"
              >
                {{ image | image_url: width: 360 | image_tag: widths: '120, 240, 360', sizes: '(min-width: 750px) 12vw, 22vw', alt: '', loading: 'lazy' }}
              </button>
            {% endfor %}
          </div>
          {% if product.images.size > 3 %}
              <button
                class="northfold-product__thumbnail-arrow"
                type="button"
                aria-label="{{ 'products.product.next_images' | t | escape }}"
                aria-controls="NorthfoldThumbnails-{{ section.id }}"
                data-northfold-thumbnail-next
              ><span aria-hidden="true">&rarr;</span></button>
            </div>
          {% endif %}
        {% endif %}
      {% else %}
        <div class="northfold-product__empty-media" aria-hidden="true"></div>
      {% endif %}
    </div>

    <div class="northfold-product__details">
      <h1 class="northfold-product__title" id="NorthfoldProductTitle-{{ section.id }}">{{ product.title | escape }}</h1>
      <p class="northfold-product__price" aria-label="{{ 'products.product.price' | t | escape }}" aria-live="polite">
        <span data-northfold-price>{{ current_variant.price | money }}</span>
      </p>
      <div class="northfold-product__description">{{ product.description }}</div>

      {% form 'product', product, id: product_form_id, class: 'northfold-product__form' %}
        {% unless product.has_only_default_variant %}
          <div class="northfold-product__options" data-northfold-options>
            {% for option in product.options_with_values %}
              <fieldset class="northfold-product__option">
                <legend>{{ option.name | escape }}</legend>
                <div class="northfold-product__values">
                  {% for option_value in option.values %}
                    {% capture option_input_id %}NorthfoldProductOption-{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}{% endcapture %}
                    <input
                      class="northfold-product__option-input"
                      type="radio"
                      id="{{ option_input_id }}"
                      name="northfold-option-{{ section.id }}-{{ option.position }}"
                      value="{{ option_value | escape }}"
                      data-option-position="{{ option.position }}"
                      data-option-value-id="{{ option_value.id }}"
                      {% if option_value.selected %}checked{% endif %}
                      {% unless option_value.available %}disabled{% endunless %}
                    >
                    <label class="northfold-product__option-label" for="{{ option_input_id }}">
                      {{ option_value | escape }}
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
        {% endunless %}

        <input type="hidden" name="id" value="{{ current_variant.id }}" data-northfold-variant-id>

        <p class="northfold-product__status" data-northfold-status role="status" aria-live="polite">
          {% unless current_variant.available %}{{ 'products.product.sold_out' | t }}{% endunless %}
        </p>
        <div class="northfold-product__purchase-controls">
          {% if section.settings.show_quantity %}
            <div class="northfold-product__quantity">
              <label for="NorthfoldProductQuantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
              <input
                id="NorthfoldProductQuantity-{{ section.id }}"
                type="number"
                name="quantity"
                min="1"
                step="1"
                value="1"
              >
            </div>
          {% else %}
            <input type="hidden" name="quantity" value="1">
          {% endif %}
          <button
            class="northfold-product__submit"
            type="submit"
            data-northfold-submit
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              {{ 'products.product.add_to_cart' | t }}
            {% else %}
              {{ 'products.product.sold_out' | t }}
            {% endif %}
          </button>
        </div>
      {% endform %}

      {% if shipping_threshold > 0 and shipping_threshold == shipping_threshold_floor %}
        <div
          class="northfold-product__shipping-progress"
          data-northfold-shipping-progress
          data-threshold="{{ shipping_threshold }}"
          data-currency="{{ shop.currency }}"
          data-remaining-template="{{ 'sections.northfold_product.shipping_progress.remaining' | t: amount: '__AMOUNT__' | escape_once }}"
          data-unlocked-message="{{ 'sections.northfold_product.shipping_progress.unlocked' | t | escape_once }}"
          {% if cart.currency != shop.currency %}hidden{% endif %}
        >
          <div class="northfold-product__shipping-summary">
            <svg class="northfold-product__shipping-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M2.5 6.5h12v11h-12zM14.5 10h4l3 3.5v4h-7zM6.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM18.5 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" />
            </svg>
            <div class="northfold-product__shipping-copy">
              <p class="northfold-product__shipping-message" data-shipping-message role="status" aria-live="polite" aria-atomic="true">
                {% if shipping_cart_total >= shipping_threshold %}
                  {{ 'sections.northfold_product.shipping_progress.unlocked' | t | escape_once }}
                {% else %}
                  {{ 'sections.northfold_product.shipping_progress.remaining' | t: amount: shipping_remaining_formatted | escape_once }}
                {% endif %}
              </p>
              <p class="northfold-product__shipping-supporting" data-shipping-supporting{% unless shipping_cart_total >= shipping_threshold %} hidden{% endunless %}>{{ 'sections.northfold_product.shipping_progress.supporting' | t | escape_once }}</p>
            </div>
            <div class="northfold-product__shipping-totals">
              <span><span class="northfold-product__shipping-visually-hidden">{{ 'sections.northfold_product.shipping_progress.cart_total' | t | escape }}</span><span data-shipping-total>{{ cart.total_price | money }}</span></span>
              <span aria-hidden="true">/</span>
              <span><span class="northfold-product__shipping-visually-hidden">{{ 'sections.northfold_product.shipping_progress.threshold' | t | escape }}</span><span data-shipping-threshold>{{ shipping_threshold | money }}</span></span>
            </div>
          </div>
          <progress
            class="northfold-product__shipping-bar"
            aria-label="{{ 'sections.northfold_product.shipping_progress.label' | t | escape }}"
            max="100"
            value="{{ shipping_progress }}"
            data-shipping-bar
          ></progress>
        </div>
      {% endif %}
    </div>
  </div>

  {% assign benefit_count = 0 %}
  {% for block in section.blocks %}
    {% if block.settings.title != blank or block.settings.text != blank %}
      {% assign benefit_count = benefit_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  {% if benefit_count > 0 %}
    <div class="northfold-product__benefits">
      {% if section.settings.benefits_heading != blank %}
        <h2 class="northfold-product__benefits-heading">{{ section.settings.benefits_heading | escape }}</h2>
      {% endif %}
      <div class="northfold-product__benefit-list">
        {% for block in section.blocks %}
          {% if block.settings.title != blank or block.settings.text != blank %}
            <article class="northfold-product__benefit" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div>{{ block.settings.text }}</div>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .northfold-product {
    display: block;
    background-color: var(--northfold-background);
  }

  .northfold-product__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6.8vw, 5.875rem);
    align-items: start;
    padding: clamp(1.5rem, 5vw, 4rem);
  }

  .northfold-product__gallery {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
    width: min(100%, 34.2rem, 50.4vh);
    width: min(100%, 34.2rem, 50.4svh);
    justify-self: center;
  }

  .northfold-product__hero {
    overflow: hidden;
    width: 100%;
    aspect-ratio: 4 / 5.08;
    background: rgb(0 0 0 / 3%);
  }

  .northfold-product__hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .northfold-product__thumbnail-navigation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 0.5rem;
    width: 100%;
  }

  .northfold-product__thumbnail-navigation[hidden] {
    display: none;
  }

  .northfold-product__thumbnails {
    display: flex;
    grid-column: 1 / -1;
    grid-row: 1;
    min-width: 0;
    gap: 0.625rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  .northfold-product__thumbnails::-webkit-scrollbar {
    display: none;
  }

  .northfold-product__thumbnails > .northfold-product__thumbnail {
    flex: 0 0 calc((100% - 1.25rem) / 3);
    scroll-snap-align: start;
  }

  .northfold-product__thumbnail-arrow {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid currentcolor;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .northfold-product [data-northfold-thumbnail-previous] {
    grid-column: 1;
    grid-row: 2;
    justify-self: start;
  }

  .northfold-product [data-northfold-thumbnail-next] {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
  }

  .northfold-product__thumbnail-arrow:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .northfold-product__thumbnail-arrow:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .northfold-product__thumbnail {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid transparent;
    background: rgb(0 0 0 / 3%);
    cursor: pointer;
    opacity: 0.72;
    transition: opacity 160ms ease, border-color 160ms ease;
  }

  .northfold-product__thumbnail[aria-pressed='true'] {
    border-color: currentcolor;
    opacity: 1;
  }

  .northfold-product__thumbnail:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .northfold-product__thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .northfold-product__empty-media {
    min-height: 20rem;
    background: rgb(0 0 0 / 5%);
  }

  .northfold-product__details {
    min-width: 0;
    padding-block: 0.75rem;
  }

  .northfold-product__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-primary--family, inherit);
    font-size: clamp(2rem, 3.7vw, 3.25rem);
    font-weight: 400;
    line-height: 1.08;
  }

  .northfold-product__price {
    margin: 0 0 1.5rem;
    font-size: 1.35rem;
  }

  .northfold-product__price [data-northfold-price] {
    position: relative;
    display: inline-block;
  }

  .northfold-product__price [data-northfold-price][aria-busy='true']::after {
    position: absolute;
    top: 50%;
    left: calc(100% + 0.5rem);
    width: 0.7rem;
    height: 0.7rem;
    border: 1px solid currentcolor;
    border-right-color: transparent;
    border-radius: 50%;
    content: '';
    transform: translateY(-50%);
    animation: northfold-price-loading 700ms linear infinite;
  }

  @keyframes northfold-price-loading {
    to {
      transform: translateY(-50%) rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .northfold-product__price [data-northfold-price][aria-busy='true']::after {
      animation: none;
    }
  }

  .northfold-product__description {
    margin-block-end: 1.75rem;
    line-height: 1.65;
  }

  .northfold-product__shipping-progress {
    display: grid;
    gap: 0.75rem;
    margin-block-start: 1.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid #e7e2d8;
    border-radius: 0.5rem;
    background: #f5f3ed;
  }

  .northfold-product__shipping-progress[hidden] {
    display: none;
  }

  .northfold-product__shipping-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .northfold-product__shipping-icon {
    flex: 0 0 1.5rem;
    width: 1.5rem;
    height: 1.5rem;
    color: #3b402a;
  }

  .northfold-product__shipping-copy {
    flex: 1 1 auto;
    min-width: 10rem;
  }

  .northfold-product__shipping-message {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .northfold-product__shipping-supporting {
    margin: 0.2rem 0 0;
    color: #55564c;
    font-size: 0.8rem;
  }

  .northfold-product__shipping-supporting[hidden] {
    display: none;
  }

  .northfold-product__shipping-totals {
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    color: #55564c;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .northfold-product__shipping-visually-hidden {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .northfold-product__shipping-bar {
    display: block;
    width: 100%;
    height: 0.45rem;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background: #e7e2d8;
    color: #3b402a;
    accent-color: #3b402a;
  }

  .northfold-product__shipping-bar::-webkit-progress-bar {
    border-radius: 999px;
    background: #e7e2d8;
  }

  .northfold-product__shipping-bar::-webkit-progress-value {
    border-radius: 999px;
    background: #3b402a;
  }

  .northfold-product__shipping-bar::-moz-progress-bar {
    border-radius: 999px;
    background: #3b402a;
  }

  .northfold-product__option {
    min-width: 0;
    margin: 0 0 1.25rem;
    padding: 0;
    border: 0;
  }

  .northfold-product__option legend,
  .northfold-product__quantity label {
    margin-block-end: 0.6rem;
    font-weight: 600;
  }

  .northfold-product__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .northfold-product__option-input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  .northfold-product__option-label {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.6rem 1rem;
    border: 1px solid currentcolor;
    cursor: pointer;
  }

  .northfold-product__option-input:checked + .northfold-product__option-label {
    background: var(--color-foreground, #333230);
    color: var(--color-background, #fff);
  }

  .northfold-product__option-input:disabled + .northfold-product__option-label {
    cursor: not-allowed;
    opacity: 0.45;
    text-decoration: line-through;
  }

  .northfold-product__option-input:focus-visible + .northfold-product__option-label {
    outline: 2px solid currentcolor;
    outline-offset: 3px;
  }

  .northfold-product__quantity {
    display: grid;
    flex: 0 0 6.5rem;
    max-width: 6.5rem;
    gap: 0.5rem;
  }

  .northfold-product__purchase-controls {
    display: flex;
    width: min(100%, 28rem);
    align-items: flex-end;
    gap: 0.75rem;
  }

  .northfold-product__quantity input {
    width: 100%;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
  }

  .northfold-product__status:empty {
    display: none;
  }

  .northfold-product__submit {
    flex: 1 1 12rem;
    min-width: 0;
    width: auto;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border: 0;
    background: var(--color-foreground, #333230);
    color: var(--color-background, #fff);
    cursor: pointer;
  }

  .northfold-product__submit:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  .northfold-product__benefits {
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem);
  }

  .northfold-product__benefits-heading {
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .northfold-product__benefit-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 1.5rem;
  }

  .northfold-product__benefit {
    padding: 1.25rem;
    border: 1px solid rgb(0 0 0 / 12%);
  }

  .northfold-product__benefit h3 {
    margin: 0 0 0.5rem;
  }

  @media (max-width: 749px) {
    .northfold-product__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1.25rem;
    }

    .northfold-product__gallery {
      gap: 0.625rem;
      width: 100%;
      justify-self: stretch;
    }

    .northfold-product__hero {
      aspect-ratio: 1 / 0.96;
    }

    .northfold-product__thumbnail-navigation {
      gap: 0.375rem;
    }

    .northfold-product__thumbnail-arrow {
      width: 1.75rem;
      height: 1.75rem;
    }

    .northfold-product__thumbnails {
      gap: 0.5rem;
    }

    .northfold-product__thumbnails > .northfold-product__thumbnail {
      flex-basis: calc((100% - 1rem) / 3);
    }

    .northfold-product__details {
      padding-block: 0;
    }

    .northfold-product__purchase-controls {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
    }

    .northfold-product__quantity {
      flex-basis: auto;
      max-width: 10rem;
    }

    .northfold-product__submit {
      flex: initial;
      width: 100%;
    }

    .northfold-product__shipping-progress {
      padding: 0.875rem;
    }

    .northfold-product__shipping-summary {
      flex-wrap: wrap;
    }

    .northfold-product__shipping-copy {
      min-width: 0;
    }

    .northfold-product__shipping-totals {
      flex: 1 1 100%;
      margin-inline-start: 2.25rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const pendingRequests = new Map();
    const pendingCartSections = new Set();

    document.addEventListener('northfold:cart-state-updated', (event) => {
      const freshCart = event.detail?.cart;
      if (!Number.isSafeInteger(freshCart?.total_price) || freshCart.total_price < 0) return;
      if (typeof freshCart.currency !== 'string') return;

      document.querySelectorAll('[data-northfold-shipping-progress]').forEach((progressElement) => {
        const threshold = Number(progressElement.dataset.threshold);
        if (!Number.isSafeInteger(threshold) || threshold <= 0 || freshCart.currency !== progressElement.dataset.currency) {
          progressElement.hidden = true;
          return;
        }

        const formatter = new Intl.NumberFormat(document.documentElement.lang || undefined, {
          style: 'currency',
          currency: freshCart.currency
        });
        const subunitsPerUnit = 10 ** formatter.resolvedOptions().maximumFractionDigits;
        const remaining = Math.max(0, threshold - freshCart.total_price);
        const percentage = Math.max(0, Math.min(100, freshCart.total_price / threshold * 100));
        const message = progressElement.querySelector('[data-shipping-message]');
        const bar = progressElement.querySelector('[data-shipping-bar]');
        const total = progressElement.querySelector('[data-shipping-total]');
        const thresholdValue = progressElement.querySelector('[data-shipping-threshold]');
        const supportingMessage = progressElement.querySelector('[data-shipping-supporting]');

        if (freshCart.total_price >= threshold) {
          message.textContent = progressElement.dataset.unlockedMessage;
          supportingMessage.hidden = false;
        } else {
          const remainingAmount = formatter.format(remaining / subunitsPerUnit);
          message.textContent = progressElement.dataset.remainingTemplate.replace('__AMOUNT__', remainingAmount);
          supportingMessage.hidden = true;
        }

        bar.value = percentage;
        bar.setAttribute('aria-valuenow', String(percentage));
        total.textContent = formatter.format(freshCart.total_price / subunitsPerUnit);
        thresholdValue.textContent = formatter.format(threshold / subunitsPerUnit);
        progressElement.hidden = false;
      });
    });

    // 1. Delegated submit listener for AJAX Add to Cart
    document.addEventListener('submit', async (event) => {
      const form = event.target.closest('form.northfold-product__form');
      if (!form) return;

      // Prevent standard browser POST submission & 302 redirect
      event.preventDefault();
      event.stopImmediatePropagation();

      const productSection = form.closest('[data-northfold-product]');
      const sectionId = productSection?.dataset.sectionId || 'default';

      if (pendingCartSections.has(sectionId)) return;

      const variantInput = form.querySelector('input[name="id"]');
      const quantityInput = form.querySelector('input[name="quantity"]');
      const submitButton = form.querySelector('[data-northfold-submit]');
      const statusElement = productSection?.querySelector('[data-northfold-status]');

      if (!variantInput?.value) {
        console.error('Northfold: No variant selected');
        return;
      }

      const quantity = Number(quantityInput?.value || 1);
      const originalText = submitButton?.textContent;
      const wasDisabled = submitButton?.disabled ?? false;

      pendingCartSections.add(sectionId);
      form.setAttribute('aria-busy', 'true');
      if (submitButton) submitButton.disabled = true;
      if (statusElement) statusElement.textContent = '';

      try {
        const rootUrl = window.Shopify?.routes?.root || '/';
        const endpoint = `${rootUrl.replace(/\/+$/, '')}/cart/add.js`;

        const response = await window.fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: [
              {
                id: Number(variantInput.value),
                quantity: quantity
              }
            ]
          })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.description || data.message || 'Error adding item to cart');
        }

        try {
          const rootUrl = window.Shopify?.routes?.root || '/';
          const cartEndpoint = `${rootUrl.replace(/\/+$/, '')}/cart.js?_=${Date.now()}`;
          const cartResponse = await window.fetch(cartEndpoint, {
            headers: { 'Accept': 'application/json' }
          });

          if (!cartResponse.ok) throw new Error('Unable to refresh cart state');

          const freshCart = await cartResponse.json();
          if (!Number.isInteger(freshCart?.item_count) || freshCart.item_count < 0) {
            throw new Error('Cart response has an invalid item count');
          }

          document.dispatchEvent(new CustomEvent('northfold:cart-state-updated', { detail: { cart: freshCart } }));
        } catch (cartRefreshError) {
          console.error('Northfold cart refresh error:', cartRefreshError);
        }

        // Trigger cart drawers or global count indicators
        document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: data } }));
        document.dispatchEvent(new CustomEvent('cart:refresh'));

        // Temporary visual confirmation on button
        if (submitButton) {
          submitButton.textContent = 'Added to Cart!';
          setTimeout(() => {
            submitButton.textContent = originalText;
          }, 2000);
        }
      } catch (error) {
        console.error('Northfold AJAX cart error:', error);
        if (statusElement) {
          statusElement.textContent = error.message;
        }
      } finally {
        pendingCartSections.delete(sectionId);
        form.removeAttribute('aria-busy');
        if (submitButton) submitButton.disabled = wasDisabled;
      }
    });

    // 2. Thumbnail & Gallery Controls
    const selectThumbnail = (gallery, thumbnail) => {
      const heroImage = gallery.querySelector('.northfold-product__hero img');
      if (!heroImage) return;

      heroImage.src = thumbnail.dataset.imageSrc;
      heroImage.srcset = thumbnail.dataset.imageSrcset;
      heroImage.alt = thumbnail.dataset.imageAlt;

      gallery.querySelectorAll('[data-northfold-thumbnail]').forEach((item) => {
        item.setAttribute('aria-pressed', item === thumbnail ? 'true' : 'false');
      });
    };

    const initializeThumbnailNavigation = (gallery) => {
      if (!gallery) return;
      const navigation = gallery.querySelector('[data-northfold-thumbnail-navigation]');
      const thumbnails = gallery.querySelector('[data-northfold-thumbnails]');
      if (!navigation || !thumbnails) return;

      const previousButton = navigation.querySelector('[data-northfold-thumbnail-previous]');
      const nextButton = navigation.querySelector('[data-northfold-thumbnail-next]');
      const updateControls = () => {
        const maxScroll = thumbnails.scrollWidth - thumbnails.clientWidth;
        navigation.hidden = maxScroll <= 1;
        previousButton.disabled = thumbnails.scrollLeft <= 1;
        nextButton.disabled = thumbnails.scrollLeft >= maxScroll - 1;
      };

      previousButton.addEventListener('click', () => {
        thumbnails.scrollBy({ left: -thumbnails.clientWidth, behavior: 'smooth' });
      });
      nextButton.addEventListener('click', () => {
        thumbnails.scrollBy({ left: thumbnails.clientWidth, behavior: 'smooth' });
      });
      thumbnails.addEventListener('scroll', updateControls, { passive: true });
      updateControls();
    };

    document.querySelectorAll('[data-northfold-gallery]').forEach(initializeThumbnailNavigation);

    document.addEventListener('click', (event) => {
      const thumbnail = event.target.closest('[data-northfold-thumbnail]');
      if (!thumbnail) return;

      const gallery = thumbnail.closest('[data-northfold-gallery]');
      if (gallery) selectThumbnail(gallery, thumbnail);
    });

    // 3. Variant Change / Section Rendering
    document.addEventListener('change', async (event) => {
      const optionInput = event.target.closest('[data-option-value-id]');
      if (!optionInput) return;

      const productSection = optionInput.closest('[data-northfold-product]');
      if (!productSection) return;

      const sectionId = productSection.dataset.sectionId;
      const previousRequest = pendingRequests.get(sectionId);
      if (previousRequest) previousRequest.abort();

      const requestController = new AbortController();
      pendingRequests.set(sectionId, requestController);

      const selectedOptionValues = Array.from(
        productSection.querySelectorAll('[data-option-value-id]:checked'),
      ).map((input) => input.dataset.optionValueId);

      const requestUrl = new URL(productSection.dataset.productUrl, window.location.origin);
      requestUrl.searchParams.set('section_id', sectionId);
      requestUrl.searchParams.set('option_values', selectedOptionValues.join(','));

      const submitButton = productSection.querySelector('[data-northfold-submit]');
      const status = productSection.querySelector('[data-northfold-status]');
      const price = productSection.querySelector('[data-northfold-price]');
      submitButton.disabled = true;
      status.textContent = '';
      price.setAttribute('aria-busy', 'true');

      try {
        const response = await fetch(requestUrl, { signal: requestController.signal });
        if (!response.ok) throw new Error('Section update failed');

        const responseMarkup = await response.text();
        const parsedDocument = new DOMParser().parseFromString(responseMarkup, 'text/html');
        const updatedSection = Array.from(parsedDocument.querySelectorAll('[data-northfold-product]'))
          .find((section) => section.dataset.sectionId === sectionId);

        if (!updatedSection) throw new Error('Updated product section was not returned');
        if (pendingRequests.get(sectionId) !== requestController) return;

        const activeImageId = productSection.querySelector('[data-northfold-thumbnail][aria-pressed="true"]')?.dataset.imageId;
        const focusedPosition = optionInput.dataset.optionPosition;
        const focusedValue = optionInput.value;
        const shippingProgress = productSection.querySelector('[data-northfold-shipping-progress]');
        const updatedShippingProgress = updatedSection.querySelector('[data-northfold-shipping-progress]');
        if (shippingProgress) {
          if (updatedShippingProgress) {
            updatedShippingProgress.replaceWith(shippingProgress);
          } else {
            updatedSection.querySelector('.northfold-product__form')?.after(shippingProgress);
          }
        }

        productSection.replaceWith(updatedSection);
        initializeThumbnailNavigation(updatedSection.querySelector('[data-northfold-gallery]'));

        if (activeImageId) {
          const updatedThumbnail = Array.from(updatedSection.querySelectorAll('[data-northfold-thumbnail]'))
            .find((thumbnail) => thumbnail.dataset.imageId === activeImageId);
          if (updatedThumbnail) selectThumbnail(updatedSection.querySelector('[data-northfold-gallery]'), updatedThumbnail);
        }

        const updatedOptions = updatedSection.querySelectorAll('[data-option-value-id]');
        const updatedFocusedInput = Array.from(updatedOptions).find((input) =>
          input.dataset.optionPosition === focusedPosition && input.value === focusedValue,
        );
        if (updatedFocusedInput) updatedFocusedInput.focus({ preventScroll: true });
      } catch (error) {
        if (error.name === 'AbortError') return;
        if (pendingRequests.get(sectionId) !== requestController) return;

        submitButton.disabled = true;
        status.textContent = productSection.dataset.errorMessage;
      } finally {
        if (pendingRequests.get(sectionId) === requestController) {
          price.removeAttribute('aria-busy');
          pendingRequests.delete(sectionId);
        }
      }
    });
  })();
{% endjavascript %}

